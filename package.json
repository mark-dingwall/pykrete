{
  "name": "pykrete",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pykrete": "bin/pykrete.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:e2e": ": \"${PYKRETE_NEW_PI_BIN:?set it to the real pi binary — the e2e suite skips silently without it}\" && node --experimental-strip-types --test 'src/**/*.e2e.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "typebox": "1.1.38",
    "@earendil-works/pi-coding-agent": "0.80.10"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  }
}
